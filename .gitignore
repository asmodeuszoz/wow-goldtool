# ---- Rust / Cargo -----------------------------------------------------------
/target
*.pdb

# ---- Tauri ------------------------------------------------------------------
# Generated by the Tauri CLI at build time (regenerated on every `tauri build`).
src-tauri/gen/
src-tauri/_tauri/
src-tauri/_assets.gen.rs

# Written by tauri-build at compile time. The flat layout (ADR 0001) has no src-tauri/ to
# hide such artifacts in, so they sit next to Cargo.toml: /gen/schemas/*.json.
/gen/

# SQLite database lives in the app data dir at runtime, never in the repo.
*.sqlite
*.sqlite-wal
*.sqlite-shm

# ---- Editors / IDEs ---------------------------------------------------------
.idea/
*.iml
.junie/
.vscode/
.DS_Store

# Local tooling config (OpenCode), kept out of the public repo.
opencode.json
.directory
